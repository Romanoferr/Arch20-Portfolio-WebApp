{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-analytics",
  "main": "index.js",
  "compatibility_date": "2026-08-24",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://brunacamara-arq.com.br,http://localhost:5173",
    "RETENTION_DAYS": "180"
  }
}