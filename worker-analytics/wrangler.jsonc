{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-analytics",
  "main": "index.js",
  "compatibility_date": "2026-08-24",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Vars (não-segredos) são injetadas pelo CI via `--var`:
  //   ALLOWED_ORIGINS, SITE_DOMAIN, RETENTION_DAYS
  // Secrets são injetadas pelo CI via `--secrets-file`:
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
  "vars": {
    "RETENTION_DAYS": "180"
  }
}
