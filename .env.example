VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_WHATSAPP_NUMBER=5521985330175
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_KEY=

# Cloudflare R2 — Frontend
# =========================
# URL pública para entrega das imagens desde o R2 (custom domain).
VITE_R2_PUBLIC_URL=https://images.brunacamara-arq.com.br

# URL base do Worker de image delivery (imagens otimizadas via Cloudflare
# Image Transformations). O frontend usa esta URL para TODAS as imagens.
VITE_IMG_BASE_URL=https://img.brunacamara-arq.com.br

# URL base do Worker de image delivery (imagens otimizadas via Cloudflare
# Image Transformations). O frontend usa esta URL para TODAS as imagens.
VITE_IMG_BASE_URL=https://img.brunacamara-arq.com.br

# Endpoint do Worker de analytics (coleta privacy-first de sessões).
# Ex.: https://portfolio-analytics.<sua-conta>.workers.dev/api/collect
VITE_ANALYTICS_ENDPOINT=

# Endpoints do Cloudflare Worker (capa segura que valida sessão e assina URLs).
# Precisam ser os endereços publicados do Worker, ex.:
#   https://portfolio-arquitetura-r2.<sua-conta>.workers.dev
VITE_R2_UPLOAD_ENDPOINT=
VITE_R2_DELETE_ENDPOINT=

# Cloudflare R2 — Server-side (NUNCA use prefixo VITE_ e NUNCA exponha)
# =========================================================
# Essas chaves vivem APENAS no Worker / scripts. Não podem ir ao bundle.
# No GitHub Actions elas devem ir como Secrets (não como vars) para o build
# (apenas as VITE_*) e para o CLOUDFLARE_API_TOKEN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SUPABASE_JWT_SECRET=

# Deploy do Worker no GitHub Actions
# ==================================
CLOUDFLARE_API_TOKEN=