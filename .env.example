# =====================================================================
# TEMPLATE DE PORTAFOLIO DE ARQUITETURA
# Copie este arquivo para `.env` e preencha com os dados do novo cliente.
# NUNCA commite o `.env` (ele est� no .gitignore).
# =====================================================================

# ---------------------------------------------------------------
# SEO / Site
# ---------------------------------------------------------------
# URL p�blica do site (sem barra final). Usada pelos scripts de
# pr�-renderiza��o/sitemap e no SEO runtime (src/config/seo.ts).
VITE_SITE_URL=https://seu-dominio.com.br

# ---------------------------------------------------------------
# EmailJS (formul�rio de contato)
# ---------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ---------------------------------------------------------------

# Supabase � Frontend (cliente an�nimo)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Cloudflare R2 � Frontend
# ---------------------------------------------------------------
# URL p�blica do custom domain do bucket R2 (fallback em dev).
VITE_R2_PUBLIC_URL=

# URL base do Worker de image delivery (imagens otimizadas via Cloudflare
# Image Transformations). O frontend usa esta URL para TODAS as imagens.
VITE_IMG_BASE_URL=

# Endpoint do Worker de analytics (coleta privacy-first de sess�es).
# Ex.: https://portfolio-analytics.<sua-conta>.workers.dev/api/collect
VITE_ANALYTICS_ENDPOINT=

# Endpoints do Cloudflare Worker (capa segura que valida sess�o e assina URLs).
# Ex.: https://portfolio-arquitetura-r2.<sua-conta>.workers.dev
VITE_R2_UPLOAD_ENDPOINT=
VITE_R2_DELETE_ENDPOINT=

# ---------------------------------------------------------------
# Supabase � Server-side (NUNCA prefixo VITE_; NUNCA exponha)
# Usadas pelos Workers/scripts. V�o como secrets do Cloudflare/GitHub.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_KEY=

# ---------------------------------------------------------------
# Cloudflare R2 � Server-side (NUNCA prefixo VITE_; NUNCA exponha)
# ---------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Deploy do Worker no GitHub Actions
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------
# GitHub Variables adicionais de deploy (por cliente)
# ---------------------------------------------------------------
# URL pública do site (mesmo valor de VITE_SITE_URL) — usada pelos Workers
# para montar ALLOWED_ORIGINS / SITE_DOMAIN no deploy.
SITE_URL_FRONTEND=https://seu-dominio.com.br
# Domínio do site (sem protocolo, ex.: seu-dominio.com.br) — analytics.
SITE_DOMAIN=seu-dominio.com.br
# Custom domain de entrega de imagens (ex.: img.seu-dominio.com.br).
IMG_DELIVERY_DOMAIN=img.seu-dominio.com.br
# Base path do GitHub Pages quando o site não está na raiz (ex.: /repo/).
VITE_BASE_PATH=/